# Copiá este archivo como ".env" (en esta misma carpeta) y completá tus valores.
# El .env NO se sube a Git. Acá solo van valores de ejemplo.

# Generá una con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=peachbeach
DB_USER=peachbeaches
DB_PASSWORD=cambiar_por_tu_clave_local
DB_HOST=localhost
DB_PORT=5432
# En local dejar "prefer". En la base de la nube suele ser "require".
DB_SSLMODE=prefer

# Dominios del frontend permitidos (separados por coma, sin "/" al final)
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Solo producción: dominio https del backend (para entrar al /admin/)
CSRF_TRUSTED_ORIGINS=
